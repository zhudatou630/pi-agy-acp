{
  "name": "pi-agy-acp",
  "version": "0.2.2",
  "description": "Antigravity CLI (agy acp) as a pi provider, tuned for pi-web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhudatou630/pi-agy-acp.git"
  },
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "private": true,
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node test/smoke-real-agy.ts",
    "acp:tail": "node scripts/acp-tail.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "^24.0.0",
    "typebox": "*",
    "typescript": "^5.9.0"
  }
}
